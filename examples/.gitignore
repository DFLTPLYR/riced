# Generated by `riced build -p .`: the locked Cargo package for the shell.
# The built binary lands in target/riced-shell/, already ignored by the
# repository-root .gitignore.
/.riced/

# Lua libraries seeded on first run. `settings/` is committed beside this file
# as an example of a project-owned Settings page, so it is intentionally not
# ignored; these directories are created only when absent.
/components/
/shaders/
/widgets/

# Created by `riced generate-theme`, not by running the shell.
/theme/
/templates/

# Library and feature initialization markers, one per seeded directory.
.*-initialized

# Generated configuration artifacts (legacy TOML migration, seeded widget list).
/config.toml.migrated
/widgets.toml
/widgets.toml.migrated
